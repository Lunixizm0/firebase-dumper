{
  "name": "firebase-dump",
  "version": "5.0.1",
  "description": "Firebase project dump extracts firestore, auth, storage, rtdb and more via Admin SDK",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "firebase-dump": "dist/bin/firebase-dump.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/bin/firebase-dump.ts",
    "dev": "node src/bin/firebase-dump.ts",
    "dump": "node src/bin/firebase-dump.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "firebase",
    "firestore",
    "backup",
    "dump",
    "admin-sdk"
  ],
  "author": "Lunixizm0",
  "license": "MIT",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "dependencies": {
    "@firebase/app": "^0.11.5",
    "commander": "^15.0.0",
    "firebase-admin": "^14.2.0",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/tar": "^6.1.13",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-regexp": "^3.1.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.8.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
